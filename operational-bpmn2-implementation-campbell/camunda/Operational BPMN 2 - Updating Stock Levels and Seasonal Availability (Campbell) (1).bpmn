    <bpmn:messageFlow id="Flow_1qgl6k6" name="Product availability update" sourceRef="Event_1yggb22" targetRef="Participant_1rpfvn9" />
    <bpmn:textAnnotation id="TextAnnotation_0n3pfda">
      <bpmn:text>product, stock quantity, season start date, season end date</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12hdkbc">
      <bpmn:text>Use Case 1: stock = 0 → unavailable; restocked + in season → available; restocked + out of season → hidden until season starts</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_18an9q5">
      <bpmn:text>Reusable call activity – shared with Functionality 1</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1dt5n4m">
      <bpmn:text>i* SR: realises Registered Producer task Update Stock and Seasons and Marketplace System tasks Validate Data and Update Display; satisfies Customer dependency Accurate Availability information</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_115f9s3" associationDirection="None" sourceRef="Activity_1pp7r77" targetRef="TextAnnotation_0n3pfda" />
