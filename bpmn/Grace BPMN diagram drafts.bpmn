  <bpmn:collaboration id="Collaboration_Marketplace" isClosed="false">
    <bpmn:participant id="Participant_Marketplace" name="Local Food Marketplace" />
    <bpmn:participant id="Participant_Financials" name="Financial Operations" processRef="Process_WeeklyPayouts" />
  </bpmn:collaboration>
  <bpmn:process id="Process_WeeklyPayouts" name="Weekly Producer Payout" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Timer" name="Weekly on Friday 9am">
      <bpmn:outgoing>Flow_W01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 9 ? * FRI</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_FetchOrders" name="Fetch Completed Orders for Week" implementation="##WebService">
      <bpmn:incoming>Flow_W01</bpmn:incoming>
      <bpmn:outgoing>Flow_W02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_CalculateCommission" name="Calculate 5% Commission" implementation="##unspecified">
      <bpmn:incoming>Flow_W02</bpmn:incoming>
      <bpmn:outgoing>Flow_W03</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_ExecutePayouts" name="Execute Producer Payouts" implementation="##WebService">
      <bpmn:incoming>Flow_W03</bpmn:incoming>
      <bpmn:outgoing>Flow_W04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendStatements" name="Send Weekly Statements" zeebe:modelerTemplate="io.camunda.connectors.SendGrid.v2" zeebe:modelerTemplateVersion="5" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendgrid:1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W04</bpmn:incoming>
      <bpmn:outgoing>Flow_W05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PayoutsDone" name="Payouts Complete">
      <bpmn:incoming>Flow_W05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_W01" sourceRef="StartEvent_Timer" targetRef="Task_FetchOrders" />
    <bpmn:sequenceFlow id="Flow_W02" sourceRef="Task_FetchOrders" targetRef="Task_CalculateCommission" />
    <bpmn:sequenceFlow id="Flow_W03" sourceRef="Task_CalculateCommission" targetRef="Task_ExecutePayouts" />
    <bpmn:sequenceFlow id="Flow_W04" sourceRef="Task_ExecutePayouts" targetRef="Task_SendStatements" />
    <bpmn:sequenceFlow id="Flow_W05" sourceRef="Task_SendStatements" targetRef="EndEvent_PayoutsDone" />
  </bpmn:process>
