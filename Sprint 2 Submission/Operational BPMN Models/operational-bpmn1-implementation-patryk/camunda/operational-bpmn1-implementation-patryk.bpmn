    <bpmn:textAnnotation id="TextAnnotation_027m7sm">
      <bpmn:text>name, description, category, price, quantity, availability dates, farm origin, allergens, harvest/best-before dates, if it is organic</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1c9dwwh" associationDirection="None" sourceRef="Activity_1dk436x" targetRef="TextAnnotation_027m7sm" />
